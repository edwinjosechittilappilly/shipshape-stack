# Copy to .env for local overrides. Never commit real secrets; .env is git-ignored and agent hooks refuse to read it.
# Every variable has a safe local default, so the stack runs without a .env file.

# Backend
APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# docker compose
POSTGRES_PORT=5432

# Frontend container (nginx) upstream for /api/
API_UPSTREAM=http://backend:8000

# Playwright full-stack project
E2E_BASE_URL=http://localhost:8080
