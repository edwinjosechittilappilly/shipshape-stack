{
  "description": "Repo guardrails shared with Claude Code and Cursor. Scripts live in scripts/agent-hooks (see docs/agents/hooks.md). Codex asks you to review and trust these once via /hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/agent-hooks/guard-shell.sh\" --codex",
            "timeout": 10,
            "statusMessage": "Checking shell command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/agent-hooks/format-file.sh\" --codex",
            "timeout": 30,
            "statusMessage": "Formatting edited files"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/agent-hooks/stop-gate.sh\" --codex",
            "timeout": 300,
            "statusMessage": "Running lint and typecheck on changed packages"
          }
        ]
      }
    ]
  }
}
