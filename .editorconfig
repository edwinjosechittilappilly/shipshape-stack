# https://editorconfig.org — one baseline for every editor and for agents that honour it.
# Formatters (ruff, prettier) remain the source of truth; this only keeps raw edits close to what they produce.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

# Makefiles require tabs for recipes.
[{Makefile,*.mk}]
indent_style = tab

[*.md]
trim_trailing_whitespace = true
