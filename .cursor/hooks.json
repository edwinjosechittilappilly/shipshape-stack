{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "scripts/agent-hooks/guard-shell.sh --cursor",
        "timeout": 10
      }
    ],
    "afterFileEdit": [
      {
        "command": "scripts/agent-hooks/format-file.sh --cursor",
        "timeout": 30
      }
    ],
    "stop": [
      {
        "command": "scripts/agent-hooks/stop-gate.sh --cursor",
        "timeout": 300,
        "loop_limit": 2
      }
    ]
  }
}
