# Rendered by the nginx image entrypoint (envsubst, filtered to API_UPSTREAM and NGINX_LOCAL_RESOLVERS) into /etc/nginx/conf.d/default.conf.

server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Security headers (see security-headers.conf; `always` keeps them on error responses too).
    include /etc/nginx/security-headers.conf;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    server_tokens off;

    # Liveness for compose / Kubernetes probes: answers without touching the backend.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Backend API. The upstream sits in a variable and is resolved per request (short TTL) rather than once at boot:
    # with a literal host nginx refuses to start until the backend's DNS name exists, which turns a slow backend
    # rollout into a frontend crash loop. With a variable and no URI part, the original /api/... path is forwarded as-is.
    location /api/ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
        set $api_upstream "${API_UPSTREAM}";
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Vite emits content-hashed filenames under /assets, so they can be cached forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/security-headers.conf;
        try_files $uri =404;
    }

    # index.html is not hashed: always revalidate so a deploy is picked up immediately.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;
    }

    # SPA fallback: unknown paths serve the app shell so client-side routes survive a refresh.
    location / {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;
        try_files $uri /index.html;
    }
}
